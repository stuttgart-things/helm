{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "commitMessageTopic": "helm chart {{depName}}",
  "ignorePaths": [
    ".k2n/**",
    "tests/**"
  ],
  "helmfile": {
    "managerFilePatterns": [
      "/(^|/).*\\.ya?ml(?:\\.gotmpl)?$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Chart versions parameterized through helmfile environment values (invisible to the helmfile manager)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(apps|cicd|database|infra|monitoring)/.*\\.ya?ml(?:\\.gotmpl)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*- \\w+: \"?(?<currentValue>[^\"{\\s][^\"\\s]*)\"?"
      ]
    },
    {
      "description": "Same, but where the environment value itself carries a Go template default",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(apps|cicd|database|infra|monitoring)/.*\\.ya?ml(?:\\.gotmpl)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n\\s*- \\w+: \\{\\{[^\\n]*default \"(?<currentValue>[^\"]+)\"[^\\n]*\\}\\}"
      ]
    }
  ]
}
