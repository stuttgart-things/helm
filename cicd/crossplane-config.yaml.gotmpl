---
environments:
  default:
    values:
      - namespace: crossplane-system
      # derivedNames: false (default) keeps every CR name as it has always
      # been. true switches each entry that carries a `derivedName` to it --
      # the name Crossplane itself derives from the package path, and the one
      # the flux machinery profile and the xplane-crossplane-catalog use
      # (stuttgart-things/flux#506). Set it with
      #   helmfile apply ... --state-values-set derivedNames=true
      #
      # FRESH CLUSTERS ONLY. A rename on a live cluster is not a rename: the
      # release creates the new CR and helm deletes the old one, and deleting
      # a Configuration takes its XRDs -- and every XR on them -- with it. Leaving the old CR in place instead
      # gives two CRs for one source, a duplicate Lock node, and every package
      # on the cluster goes Healthy=False. The kind_machinery play checks for
      # CRs under the old names before it sets this, and stops.
      #
      # Opt-in rather than the default because not every consumer pins this
      # repo: plays/kind-machinery-test.yaml (ansible), the
      # platform-engineering-showcase Taskfile/bundle and dev3-kind apply
      # these helmfiles from main, with no preflight in front of them.
      - derivedNames: false
      - functions:
          autoReady:
            name: function-auto-ready
            apiVersion: pkg.crossplane.io/v1beta1
            image: xpkg.crossplane.io/crossplane-contrib/function-auto-ready
            # Pinned <v0.7.0: the stuttgart-things Configuration packages (namespace,
            # volume-claim, vspherevm, …) declare dependsOn function-auto-ready
            # >=v0.6.5,<v0.7.0. Installing v0.7.0 makes those Configurations'
            # package revisions Unhealthy ("incompatible dependencies"). Bump only
            # once the Configuration packages widen the constraint.
            #
            # v0.6.7 (2026-08-21): die 0.6er-Linie bekommt weiter Backports —
            # v0.6.6 und v0.6.7 sind NACH v0.7.0 erschienen und enthalten nur
            # CVE-Fixes (Go 1.25.12, x/net, x/text, grpc). Unter der Decke zu
            # bleiben kostet hier also keine Sicherheitsfixes.
            tag: v0.6.7
          functionGo:
            name: function-go-templating
            apiVersion: pkg.crossplane.io/v1beta1
            image: xpkg.crossplane.io/crossplane-contrib/function-go-templating
            tag: v0.12.3
          kcl:
            name: function-kcl
            apiVersion: pkg.crossplane.io/v1
            image: xpkg.upbound.io/crossplane-contrib/function-kcl
            tag: v0.12.2
          patchAndTransform:
            name: function-patch-and-transform
            apiVersion: pkg.crossplane.io/v1beta1
            image: xpkg.upbound.io/crossplane-contrib/function-patch-and-transform
            tag: v0.10.9
          environmentConfigs:
            name: function-environment-configs
            apiVersion: pkg.crossplane.io/v1
            image: xpkg.crossplane.io/crossplane-contrib/function-environment-configs
            tag: v0.7.3
          # The dependsOn-derived twins of function-kcl and
          # function-patch-and-transform. The short names above stay on
          # xpkg.upbound.io (Compositions call functions by those names, and
          # the differing mirror keeps the two Lock nodes distinct). Every
          # Configuration dependsOn the xpkg.crossplane.io source, so the
          # package manager installs these anyway, under exactly these names,
          # at the newest version the constraint allows. Pinned here so a fresh
          # cluster matches: u26-kindtest (2026-09-19) got kcl 0.12.3 and
          # p&t 0.10.11 next to kind3's 0.12.2 / 0.10.8.
          kclDependency:
            name: crossplane-contrib-function-kcl
            apiVersion: pkg.crossplane.io/v1
            image: xpkg.crossplane.io/crossplane-contrib/function-kcl
            tag: v0.12.2
          patchAndTransformDependency:
            name: crossplane-contrib-function-patch-and-transform
            apiVersion: pkg.crossplane.io/v1
            image: xpkg.crossplane.io/crossplane-contrib/function-patch-and-transform
            # v0.10.9, the version of the short-named entry above: two versions
            # of one function add nothing. Every dependsOn allows it
            # (>=v0.10.6,<v0.11.0) and the digest is identical on both mirrors
            # -- the pattern function-kcl already runs healthy on kind5.
            # Level with xplane-crossplane-catalog 0.7.0.
            tag: v0.10.9
      # Migrated from the decommissioned ghcr.io/stuttgart-things/crossplane/...
      # registry to ghcr.io/stuttgart-things/crossplane-configurations/...
      # (Crossplane v2, namespaced XRs). Entries are re-added one at a time as
      # their replacements are pushed to the new registry.
      - configurations:
          namespace:
            name: namespace
            derivedName: stuttgart-things-crossplane-configurations-namespace
            image: ghcr.io/stuttgart-things/crossplane-configurations/namespace
            tag: v0.1.2
          volumeClaim:
            name: volume-claim
            derivedName: stuttgart-things-crossplane-configurations-volume-claim
            image: ghcr.io/stuttgart-things/crossplane-configurations/volume-claim
            tag: v0.1.0
---
releases:
  - name: crossplane-functions
    installed: true
    namespace: {{ .Values.namespace }}
    chart: stuttgart-things/sthings-cluster
    version: 0.3.20
    disableValidationOnInstall: true
    values:
      - "values/crossplane-functions.values.yaml.gotmpl"

  - name: crossplane-configurations
    installed: true
    namespace: {{ .Values.namespace }}
    chart: stuttgart-things/sthings-cluster
    version: 0.3.20
    disableValidationOnInstall: true
    values:
      - "values/crossplane-configurations.values.yaml.gotmpl"

repositories:
  - name: stuttgart-things
    url: ghcr.io/stuttgart-things
    oci: true
