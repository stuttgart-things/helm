---
customresources:
{{- range $key, $p := .Values.providers }}
  {{- /* One name for the CR, its DeploymentRuntimeConfig, SA and binding -- they move together or not at all. */}}
  {{- $crName := $p.name | required (printf "providers.%s.name is required" $key) }}
  {{- if and (eq (toString (dig "derivedNames" false $.Values)) "true") (hasKey $p "derivedName") }}
  {{- $crName = $p.derivedName }}
  {{- end }}
  {{ $key }}:
    apiVersion: {{ dig "apiVersion" "pkg.crossplane.io/v1" $p }}
    kind: Provider
    metadata:
      name: {{ $crName }}
    spec:
      package: {{ $p.package | required (printf "providers.%s.package is required" $key) }}
      {{- if or (hasKey $p "rbac") (hasKey $p "env") (hasKey $p "resources") (hasKey $p "trustBundle") }}
      runtimeConfigRef:
        apiVersion: pkg.crossplane.io/v1beta1
        kind: DeploymentRuntimeConfig
        name: {{ $crName }}
      {{- end }}
  {{- if or (hasKey $p "rbac") (hasKey $p "env") (hasKey $p "resources") (hasKey $p "trustBundle") }}
  {{ $key }}Runtimeconfig:
    apiVersion: pkg.crossplane.io/v1beta1
    kind: DeploymentRuntimeConfig
    metadata:
      name: {{ $crName }}
    spec:
      {{- if hasKey $p "rbac" }}
      serviceAccountTemplate:
        metadata:
          name: {{ $crName }}
      {{- end }}
      {{- if or (hasKey $p "env") (hasKey $p "resources") (hasKey $p "trustBundle") }}
      {{- /* trustBundle: same shape as xplane-crossplane-catalog 0.39.0 renders
             (flux gen-crossplane-profile, xplane-management-plane) -- a
             configMap volume (optional), a read-only mount and SSL_CERT_DIR,
             merged into env so the keys stay sorted like there. */}}
      {{- $env := deepCopy (dig "env" (dict) $p) }}
      {{- with (dig "trustBundle" "" $p) }}
      {{- if hasKey $env "SSL_CERT_DIR" }}
      {{- fail (printf "providers.%s: env sets SSL_CERT_DIR and trustBundle renders it" $key) }}
      {{- end }}
      {{- $_ := set $env "SSL_CERT_DIR" (printf "/etc/ssl/certs:%s" (.mountPath | default "/etc/ssl/custom")) }}
      {{- end }}
      # env, not args: every provider flag also has an environment variable,
      # and args in a DeploymentRuntimeConfig REPLACE the image defaults
      # instead of adding to them.
      deploymentTemplate:
        spec:
          selector: {}
          template:
            spec:
              containers:
                - name: package-runtime
                  {{- with $env }}
                  env:
                    {{- range $name, $value := . }}
                    - name: {{ $name }}
                      value: {{ $value | quote }}
                    {{- end }}
                  {{- end }}
                  {{- with $p.resources }}
                  resources:
                    {{- toYaml . | nindent 20 }}
                  {{- end }}
                  {{- with (dig "trustBundle" "" $p) }}
                  volumeMounts:
                    - name: trust-bundle
                      mountPath: {{ .mountPath | default "/etc/ssl/custom" }}
                      readOnly: true
                  {{- end }}
              {{- with (dig "trustBundle" "" $p) }}
              volumes:
                - name: trust-bundle
                  configMap:
                    name: {{ .configMap | default "cluster-trust-bundle" }}
                    optional: true
              {{- end }}
      {{- end }}
  {{- end }}
{{- end }}

clusterRoleBindings:
{{- range $key, $p := .Values.providers }}
  {{- $crName := $p.name }}
  {{- if and (eq (toString (dig "derivedNames" false $.Values)) "true") (hasKey $p "derivedName") }}
  {{- $crName = $p.derivedName }}
  {{- end }}
  {{- if hasKey $p "rbac" }}
  crossplane-{{ $crName }}:
    roleRef:
      kind: ClusterRole
      name: {{ $p.rbac.clusterRole }}
      apiGroup: rbac.authorization.k8s.io
    subjects:
      - kind: ServiceAccount
        name: {{ $crName }}
        namespace: {{ $.Values.namespace }}
  {{- end }}
{{- end }}
