---
environments:
  default:
    values:
      - namespace: crossplane-system
      # derivedNames: false (default) keeps every CR name as it has always
      # been. true switches each entry that carries a `derivedName` to it --
      # the name Crossplane itself derives from the package path, and the one
      # the flux machinery profile and the xplane-crossplane-catalog use
      # (stuttgart-things/flux#506). Set it with
      #   helmfile apply ... --state-values-set derivedNames=true
      #
      # FRESH CLUSTERS ONLY. A rename on a live cluster is not a rename: the
      # release creates the new CR and helm deletes the old one, and deleting
      # a Provider or Configuration takes its CRDs/XRDs -- and every managed
      # resource or XR on them -- with it. Leaving the old CR in place instead
      # gives two CRs for one source, a duplicate Lock node, and every package
      # on the cluster goes Healthy=False. The kind_machinery play checks for
      # CRs under the old names before it sets this, and stops.
      #
      # Opt-in rather than the default because not every consumer pins this
      # repo: plays/kind-machinery-test.yaml (ansible), the
      # platform-engineering-showcase Taskfile/bundle and dev3-kind apply
      # these helmfiles from main, with no preflight in front of them.
      - derivedNames: false
      # Provider CRs (installed here rather than via the upstream crossplane
      # chart's provider.packages so they can carry a runtimeConfigRef).
      #   rbac: optional. When set, additionally emits a DeploymentRuntimeConfig
      #   pinning the provider Pod to a stable ServiceAccount name (= provider
      #   name) plus a ClusterRoleBinding granting rbac.clusterRole to that SA.
      #   Needed for providers talking to the local API via InjectedIdentity
      #   (helm/opentofu). provider-kubeconfig declares its own permissions via
      #   package metadata, so it needs no binding. provider-kubernetes is
      #   listed under its dependsOn-derived name (see below).
      - providers:
          # provider-helm: name + package deliberately MATCH what the package
          # manager derives from a Configuration's dependsOn
          # (xpkg.crossplane.io/crossplane-contrib/provider-helm -> CR name
          # crossplane-contrib-provider-helm). Configurations here declare that
          # dependsOn (bootstrap/{platform,flux-init,cni,vault-config}); if this
          # install used the short name `provider-helm` on xpkg.upbound.io, the
          # dependsOn would create a SECOND Provider CR and the two would fight
          # over the releases.helm.m.crossplane.io CRD (the loser stuck
          # UnhealthyPackageRevision) — verified on a fresh machinery cluster.
          # Unlike the function-kcl mirror split (functions own no CRDs, so the
          # pair is benign), providers own CRDs, so there must be exactly ONE
          # provider-helm CR. Matching the derived name makes the dependsOn find
          # this CR (which carries the runtimeConfigRef/rbac) instead of adding
          # its own. See crossplane-configurations#147.
          providerHelm:
            name: crossplane-contrib-provider-helm
            # v1.4.0 (2026-08-21): eingebettetes Helm-SDK v3 -> v4. Die
            # Release-API bleibt gleich, das Laufzeitverhalten nicht —
            # Server-Side-Apply ist fuer NEU installierte Releases der Default
            # und `wait` haengt an kstatus statt an der alten Ready-Logik.
            # Bestehende Releases behalten ihre Apply-Methode. Weil hier jede
            # Platform-App durchlaeuft (cert-manager, openebs, cni, flux-init),
            # gehoert dieser Bump nie in dieselbe Runde wie reine CVE-Updates.
            package: xpkg.crossplane.io/crossplane-contrib/provider-helm:v1.4.0
            rbac:
              clusterRole: cluster-admin
          providerOpentofu:
            name: provider-opentofu
            derivedName: upbound-provider-opentofu
            package: xpkg.upbound.io/upbound/provider-opentofu:v1.1.6
            rbac:
              clusterRole: cluster-admin
            # Every reconcile of a Workspace is a full `tofu init/plan/apply`.
            # At the image defaults (poll 10m per resource, sync 1h across all
            # of them) six Workspaces held u26-kind3 at load 8 on 8 cores, with
            # tofu and the Proxmox provider binary together around 400% CPU,
            # for state that does not change. The cluster paid for that in
            # leader elections: kube-controller-manager, kube-scheduler,
            # crossplane-rbac-manager and openebs each restarted ~3950 times in
            # 39 days, because a saturated API server misses lease renewals.
            #
            # Drift here is Vault configuration nobody edits by hand, so an
            # hour between checks costs nothing.
            env:
              CROSSPLANE_OPENTOFU_PROVIDER_POLL: 1h
              CROSSPLANE_OPENTOFU_PROVIDER_SYNC: 6h
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: "2"
                memory: 2Gi
          providerKubeconfig:
            name: provider-kubeconfig
            derivedName: stuttgart-things-provider-kubeconfig-xpkg
            package: ghcr.io/stuttgart-things/provider-kubeconfig-xpkg:v0.13.2
          # provider-kubernetes and provider-proxmox-bpg come in only through
          # Configurations' dependsOn. Not pinned, a fresh cluster got whatever
          # the constraint allowed that day: u26-kindtest (2026-09-19) came up
          # with provider-kubernetes 1.3.1 and proxmox-bpg 1.19.3 next to
          # kind3's 1.2.1 / 1.18.0. Pinned here under the exact name and source
          # the package manager derives from the dependsOn, same as
          # provider-helm above, so the dependency finds THIS object instead
          # of adding its own. No rbac: both run with the default runtime
          # config, as they always have.
          providerKubernetes:
            name: crossplane-contrib-provider-kubernetes
            package: xpkg.crossplane.io/crossplane-contrib/provider-kubernetes:v1.2.1
          providerProxmoxBpg:
            name: valkiriaaquaticamendi-provider-proxmox-bpg
            package: xpkg.upbound.io/valkiriaaquaticamendi/provider-proxmox-bpg:v1.18.0
            # An upjet provider: every reconcile of a managed resource shells out
            # to terraform with the bpg/proxmox provider binary. At the default
            # poll of 10m and nine Proxmox resources on u26-kind3 that is a
            # terraform run roughly every 70 seconds, and it was the largest
            # single CPU consumer on that VM - larger than provider-opentofu.
            # A VM that Crossplane itself manages does not drift between polls.
            env:
              PROVIDER_POLL: 1h
              PROVIDER_SYNC: 6h
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: "2"
                memory: 2Gi
      # NOTE: the ClusterProviderConfig resources live in the separate
      # crossplane-provider-configs.yaml.gotmpl — they reference ProviderConfig
      # CRDs that only register once these providers are Healthy, so keeping
      # them here would make a single `helmfile apply` fail. Apply this helmfile
      # first, then crossplane-provider-configs once the providers are up.
---
releases:
  - name: crossplane-providers
    installed: true
    namespace: {{ .Values.namespace }}
    chart: stuttgart-things/sthings-cluster
    version: 0.3.20
    disableValidationOnInstall: true
    values:
      - "values/crossplane-providers.values.yaml.gotmpl"

repositories:
  - name: stuttgart-things
    url: ghcr.io/stuttgart-things
    oci: true
